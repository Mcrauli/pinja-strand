---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set base = site.url | stripSlash %}
{%- for p in collections.all %}
{%- if p.url and p.url != "/sitemap.xml" and p.url != "/robots.txt" %}
  <url>
    <loc>{{ base }}{{ p.url }}</loc>
    <lastmod>{{ (p.data.updated or p.date) | isoDate }}</lastmod>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
