---
layout: base.njk
nav: /blogi.html
pageCss: article
ogType: article
---
{%- set related = collections.posts | others(page.url, 3) %}
  <section class="sec" style="padding-top: 120px;">
    <div class="container">
      <div class="article-wrap">

        <a href="/blogi.html" class="back-link reveal">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Takaisin blogiin
        </a>

        {%- if image %}
        <img class="article-hero reveal" src="{{ image }}" alt="" sizes="(max-width:800px) 92vw, 740px" loading="eager" fetchpriority="high">
        {%- endif %}

        <div class="article-meta reveal">
          <span class="article-tag">{{ category }}</span>
          <span class="meta-dot"></span>
          <span class="article-date">{{ page.date | fiDate }}</span>
          <span class="meta-dot"></span>
          <span class="article-read">{{ content | readTime }} min lukuaika</span>
        </div>

        <h1 class="article-title reveal">
          {{ title | hl | safe }}
        </h1>

        {%- if excerpt %}
        <p class="article-lead reveal d1">
          {{ excerpt }}
        </p>
        {%- endif %}

        <div class="article-divider reveal"></div>

        <div class="article-body reveal d1">
{{ content | safe }}
        </div>

        <div class="author-card reveal">
          <img class="author-avatar" src="{{ tietoa.image }}" alt="{{ tietoa.imageAlt }}" width="144">
          <div>
            <div class="author-name">{{ site.person }}</div>
            <p class="author-bio">{{ tietoa.authorBio }}</p>
          </div>
        </div>

        {%- if related.length %}
        <div class="related-section reveal">
          <div class="section-label">Lue myös</div>
          <h3 style="font-family:var(--font-display);font-style:italic;font-size:1.5rem;font-weight:300;color:var(--ink);margin:8px 0 0;">
            Muita <em class="hl">artikkeleita.</em>
          </h3>
          <div class="related-grid">
            {%- for p in related %}
            <a href="{{ p.url }}" class="related-card" style="text-decoration:none;">
              {%- if p.data.image %}
              <img src="{{ p.data.image }}" alt="" sizes="(max-width:768px) 92vw, 240px">
              {%- endif %}
              <div class="related-card-tag">{{ p.data.category }}</div>
              <div class="related-card-title">{{ p.data.title | plain }}</div>
            </a>
            {%- endfor %}
          </div>
        </div>
        {%- endif %}

      </div>
    </div>
  </section>

  <section class="cta-band" style="margin-top: 80px;">
    <div class="container">
      <div class="cta-inner">
        <div class="section-label reveal">Tehdään yhteistyötä</div>
        <h2 class="section-h reveal d1">Otetaan <em class="hl">yhteyttä.</em></h2>
        <p class="section-p reveal d2">Kuulen mielelläni, mistä haaveilet.</p>
        <div class="cta-btns reveal d3">
          <a href="/yhteystiedot.html" class="btn-primary">
            Ota yhteyttä
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/portfolio.html" class="btn-ghost">Katso portfolio</a>
        </div>
      </div>
    </div>
  </section>
